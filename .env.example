# .env.example
# Skopiuj ten plik do .env i uzupełnij wartości
# cp .env.example .env

# === Baza danych PostgreSQL ===
DB_HOST=localhost
DB_NAME=postgres
DB_USER=postgres
DB_PASS=                    # wymagane — hasło do bazy danych

# Schema bazy (domyślnie: public)
DB_SCHEMA=public

# === Tokeny autoryzacyjne Mattermost ===
# Każda komenda slash ma osobny token — generowany w: Mattermost > Integrations > Slash Commands
ID_TOKEN=                   # token dla komendy /id
PPPOE_TOKEN=                # token dla komendy /pppoe

# === Konfiguracja Flask ===
FLASK_PORT=5000
FLASK_DEBUG=false           # NIE ustawiaj na true w produkcji!

# === Logowanie ===
LOG_FORMAT=text             # text (czytelne dla ludzi) lub json (dla Loki/Datadog)
